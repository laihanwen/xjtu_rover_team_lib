  <version>0.1.0</version>
  <description>Launch files and shared configuration for the AUV system.</description>
  <maintainer email="2777651780@qq.com">hanwen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>auv_interfaces</exec_depend>
  <exec_depend>auv_mapping</exec_depend>
  <exec_depend>auv_mission</exec_depend>
  <exec_depend>auv_planning</exec_depend>

[Unit]
Description=AUV pool-floor AprilTag docking test (default DISARM)
After=local-fs.target
Conflicts=auv-rov.service auv-runtime.service auv-observation.service auv-task-one.service

[Service]
Type=simple
User=auv
Group=auv
SupplementaryGroups=video dialout
RuntimeDirectory=auv-runtime
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=restart
LogsDirectory=auv-runtime
ExecStart=/usr/local/bin/auv_runtime /etc/auv-runtime/pi-auv-tag-docking.yaml
Restart=no
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target

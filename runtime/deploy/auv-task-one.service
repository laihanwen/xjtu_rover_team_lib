[Unit]
Description=AUV A2 task-one commissioning (default DISARM, no network dependency)
After=local-fs.target
Conflicts=auv-rov.service auv-runtime.service auv-observation.service

[Service]
Type=simple
User=auv
Group=auv
SupplementaryGroups=video dialout
RuntimeDirectory=auv-runtime
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=restart
LogsDirectory=auv-runtime
ExecStart=/usr/local/bin/auv_runtime /etc/auv-runtime/pi-auv-task-one.yaml
Restart=no
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target

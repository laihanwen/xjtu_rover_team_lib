[Unit]
Description=AUV lightweight mission one runtime (starts DISARMED)
After=local-fs.target

[Service]
Type=simple
User=auv
Group=auv
SupplementaryGroups=video dialout
RuntimeDirectory=auv-runtime
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=restart
LogsDirectory=auv-runtime
ExecStart=/usr/local/bin/auv_runtime /etc/auv-runtime/runtime.yaml
Restart=on-failure
RestartSec=2
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target

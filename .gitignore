# ROS 2 / colcon generated directories
/build/
/build-lightweight/
/install/
/log/

# Runtime data (keep directory placeholders)
/logs/*
!/logs/.gitkeep
/videos/*
!/videos/.gitkeep
/maps/*
!/maps/.gitkeep
/trajectory/*
!/trajectory/.gitkeep
/events/*
!/events/.gitkeep

# Large ML artifacts and datasets are versioned by manifests, not Git.
/models/artifacts/*
!/models/artifacts/.gitkeep
/datasets/raw/*
!/datasets/raw/.gitkeep
/datasets/interim/*
!/datasets/interim/.gitkeep
/datasets/processed/*
!/datasets/processed/.gitkeep
/datasets/exports/*
!/datasets/exports/.gitkeep
*.pt
*.pth
*.onnx
*.engine
*.ncnn.bin
*.ncnn.param
*.tflite

# Embedded build and IDE output
/firmware/stm32/build/
/firmware/stm32/Debug/
/firmware/stm32/Release/
/firmware/stm32/.settings/
/firmware/stm32/.project
/firmware/stm32/.cproject
/firmware/stm32/MDK-ARM/Copy_cup/
/firmware/stm32/MDK-ARM/AUV_A0/
/firmware/stm32/MDK-ARM/*.generated.uvprojx
/firmware/stm32/MDK-ARM/Copy_cup_auv.uvprojx
/firmware/stm32/MDK-ARM/*.uvguix.*
/firmware/stm32/MDK-ARM/*.uvoptx
/firmware/stm32/MDK-ARM/*.lst
/firmware/stm32/MDK-ARM/*.log
*.elf
*.hex
*.bin
*.map

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.calibration-venv/
venv/
/vision/runs/
*.ses
/annotation/.venv/
/annotation/data/

# C/C++ tooling
compile_commands.json
.cache/

# Editors and operating systems
.vscode/settings.json
.idea/
*.swp
*~
.DS_Store

# Local environment overrides and secrets
.env
.env.*
!.env.example

# Local fallback Git metadata (used only when the managed environment mounts
# an unusable read-only .git placeholder).
/.git-data/

# Locally recorded training videos and frame timestamps
/data/rov-recordings/
firmware/stm32/MDK-ARM/RTE/_AUV_A0/

/build-native/
/legacy/ros2/build/
/legacy/ros2/install/
/legacy/ros2/log/
